# Server port (Render sets PORT automatically)
PORT=3000

# Team inbox receiving customer orders
TEAM_EMAIL=imastik.co@gmail.com

# Order submission mode:
#   auto   -> automatically sends server emails when GMAIL_WEBHOOK_URL, BREVO_API_KEY, or RESEND_API_KEY is set; otherwise falls back to mailto
#   mailto -> builds client-side email draft + attachment download helpers
#   server -> submits photos, napkin sketch & voice note directly to POST /api/orders
ORDER_MODE=auto

# Optional HTTPS email transport (recommended on Render free tier, which blocks SMTP ports 25/465/587):
# 1. Google Apps Script Web App deployed inside imastik.co@gmail.com (see scripts/google-apps-script.gs)
GMAIL_WEBHOOK_URL=
GMAIL_WEBHOOK_SECRET=
# 2. Or transactional HTTP API keys (Brevo / Resend)
BREVO_API_KEY=
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=imastik Studio

# Password protecting GET /api/orders (HTTP Basic Auth; required to view server-stored orders)
ADMIN_PASSWORD=change-me-before-deploying
